{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/v2/crates/tauri-cli/schema.json",
  "productName": "PicoView",
  "version": "0.1.0",
  "identifier": "com.picoview.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PicoView",
        "fullscreen": true,
        "width": 1280,
        "height": 840,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "center": true,
        "backgroundColor": "#121214"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "webp", "gif", "bmp", "tiff", "tif", "avif"],
        "name": "Image",
        "description": "Image file",
        "role": "Viewer"
      }
    ]
  }
}
